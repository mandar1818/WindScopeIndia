# WindScope India — Backend Environment Configuration Template
# DO NOT COMMIT SECRETS OR SENSITIVE CREDENTIALS TO THIS FILE
# Copy this file to .env and configure values appropriate for your environment.

# Database Configuration
# Local development default: sqlite:///./windscope_india.db
# Production PostgreSQL example: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=sqlite:///./windscope_india.db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_SSL_MODE=prefer
DATABASE_SSL_REQUIRE=false

# Application Environment
APP_ENV=development
DEBUG=false
PORT=8000
API_V1_PREFIX=/api/v1
PROJECT_NAME="WindScope India — Renewable Energy Intelligence Platform"

# Ingestion & Administrative Security
# Required header: X-API-KEY=<token> for triggering data ingestion jobs
INGESTION_ADMIN_KEY=dev_admin_secret_key_change_in_prod

# Market Timezones
TIMEZONE_IST=Asia/Kolkata
MARKET_TIMEZONE=Asia/Kolkata

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
